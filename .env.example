# ── Client admin portal (existing) ───────────────────────────────────────────
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=change-me-to-a-strong-password
PORTAL_SESSION_SECRET=change-me-to-a-long-random-secret-string

# ── Dispensary portal — Firebase (client SDK, public) ─────────────────────────
NEXT_PUBLIC_DISPENSARY_FIREBASE_API_KEY=
NEXT_PUBLIC_DISPENSARY_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_DISPENSARY_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_DISPENSARY_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_DISPENSARY_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_DISPENSARY_FIREBASE_APP_ID=
NEXT_PUBLIC_DISPENSARY_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_DISPENSARY_FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com

# ── Dispensary portal — Firebase Admin SDK (server only) ──────────────────────
DISPENSARY_FIREBASE_ADMIN_PROJECT_ID=
DISPENSARY_FIREBASE_ADMIN_CLIENT_EMAIL=
DISPENSARY_FIREBASE_ADMIN_PRIVATE_KEY=

# ── Dispensary portal — Stripe (optional, for billing portal) ─────────────────
DISPENSARY_STRIPE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
